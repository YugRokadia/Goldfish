{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecallX",
  "version": "0.1.0",
  "identifier": "com.recallx.desktop",

  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../engine/dist/recallx-engine"
    ]
  }
}